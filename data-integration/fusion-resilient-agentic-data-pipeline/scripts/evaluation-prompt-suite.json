        "Escalation path exists",
        "Approval gates explicit"
      ],
      "scoring_notes": "Governance emphasis."
    },
    {
      "prompt_id": "GP-010",
      "category": "Golden path",
      "objective": "Define end-to-end test strategy.",
      "required_inputs": [
        "test env inventory",
        "test data policy",
        "release criteria"
      ],
      "expected_acceptance_criteria": [
        "Unit/integration/ops tests included",
        "Exit criteria explicit",
        "Evidence capture defined"
      ],
      "scoring_notes": "Completeness emphasis."
