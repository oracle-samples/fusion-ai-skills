{
  "suite_name": "fusion-resilient-agentic-data-pipeline-odt-contracts-eval",
  "version": "1.0.0",
  "initial_batch_size": 18,
  "expansion_batch_size": 6,
  "stop_conditions": {
    "required_gate_status": "green",
    "required_delta_lte": 0.02,
