# Example .env file for BOSS Extract Automation
# Copy to .env, fill in your values, and do NOT commit secrets.

# Required hosts
BOSS_HOST="https://your-fusion-host.example.com"
IDCS_HOST="https://your-idcs-host.identity.oraclecloud.com"

# Required IDCS OAuth client
IDCS_CLIENT_ID="your-client-id"
IDCS_CLIENT_SECRET="your-client-secret"

# Required Fusion/BOSS user
BOSS_USERNAME="your.username"
BOSS_PASSWORD="your-password"

# Optional ESS Basic Auth (defaults to BOSS_USERNAME/BOSS_PASSWORD if omitted)
ESS_USERNAME="your.username"
ESS_PASSWORD="your-password"

# Required scopes
IDCS_BOSS_SCOPE="urn:opc:resource:fusion:your-environment:boss/"
IDCS_BATCH_SCOPE="urn:opc:resource:fusion:your-environment:saas-batch/"

# Required run defaults
DEFAULT_OWNER="your.username"
DEFAULT_OWNER_ROLE="HCM_Job_Roles"
DEFAULT_EMAILS="your.email@example.com"
DEFAULT_NOTIFICATION="Y,Y,Y"
OUTPUT_DIR="./ai_skills/boss_extract_automation/output"

# Required DB configuration for live metadata lookup
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_CONNECT_STRING="(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=your-adb-host.oraclecloud.com))(connect_data=(service_name=your_service_name))(security=(ssl_server_dn_match=yes)))"
DB_WALLET_LOCATION="/path/to/your/wallet"
DB_WALLET_PASSWORD="your_wallet_password"

# Optional polling
POLL_INTERVAL_SEC=5
POLL_TIMEOUT_SEC=900