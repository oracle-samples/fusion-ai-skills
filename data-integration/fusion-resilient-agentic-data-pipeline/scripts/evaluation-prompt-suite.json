    {
      "prompt_id": "GP-005",
      "category": "Golden path",
      "objective": "Generate observability KPI map for pipeline operations.",
      "required_inputs": [
        "SLO targets",
        "metric namespace",
        "alert routing"
      ],
      "expected_acceptance_criteria": [
        "Includes latency/quality/retry metrics",
        "Includes alert thresholds",
        "Includes owners"
      ],
      "scoring_notes": "Coverage weighted."
    },
    {
      "prompt_id": "GP-006",
      "category": "Golden path",
      "objective": "Produce architecture decision trade-off for latency vs cost.",
      "required_inputs": [
        "latency target",
        "budget cap",
        "batch-window constraints"
      ],
      "expected_acceptance_criteria": [
        "Contains trade-off matrix",
        "Contains decision rationale",
        "Contains rollback option"
      ],
      "scoring_notes": "Fail if one axis ignored."
    },
    {
      "prompt_id": "GP-007",
      "category": "Golden path",
      "objective": "Design multi-entity orchestrated contracts.",
      "required_inputs": [
        "entity list",
        "dependency graph",
        "contract baseline"
      ],
      "expected_acceptance_criteria": [
        "Dependency-aware execution",
        "Per-entity contract checks",
        "shared failure policy"
      ],
      "scoring_notes": "System design emphasis."
    },
    {
      "prompt_id": "GP-008",
      "category": "Golden path",
      "objective": "Create cutover plan from full to incremental loads.",
      "required_inputs": [
        "cutover date",
        "validation test list",
        "rollback threshold"
      ],
      "expected_acceptance_criteria": [
        "Contains cutover pre-checks",
        "Contains dual-run validation",
        "Contains rollback triggers"
      ],
      "scoring_notes": "Operational safety focus."
