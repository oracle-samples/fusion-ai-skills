  "prompts": [
    {
      "prompt_id": "GP-001",
      "category": "Golden path",
      "objective": "Design baseline Fusion -> stage -> ODT -> publish pipeline with contract checkpoints.",
      "required_inputs": [
        "business objective",
        "artifact inventory (REST/BICC/OTBI)",
        "target platform profile"
      ],
      "expected_acceptance_criteria": [
        "Includes stage/transform/publish boundaries",
        "Lists checkpoints",
        "References contract gates"
      ],
      "scoring_notes": "Fail if checkpoints absent."
    },
    {
      "prompt_id": "GP-002",
      "category": "Golden path",
      "objective": "Define contract-first extraction plan for one entity.",
      "required_inputs": [
        "entity scope",
        "quality rules",
        "freshness SLO"
      ],
      "expected_acceptance_criteria": [
        "Defines schema + semantics + quality rules",
        "Defines owners",
        "Defines compatibility policy"
      ],
      "scoring_notes": "Fail if ownership missing."
    },
    {
      "prompt_id": "GP-003",
      "category": "Golden path",
      "objective": "Produce idempotent incremental load strategy.",
      "required_inputs": [
        "watermark strategy",
        "replay policy",
        "dedupe key"
      ],
      "expected_acceptance_criteria": [
        "Explains idempotent run-key logic",
        "Explains replay behavior",
        "Explains duplicate prevention"
      ],
      "scoring_notes": "Fail if dedupe key omitted."
    },
    {
      "prompt_id": "GP-004",
      "category": "Golden path",
      "objective": "Generate ODT retry and recovery runbook.",
